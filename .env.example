# Copy this file to .env and replace every placeholder.
# Never commit the real .env file.

# Shared JWT configuration
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=cargosphere-auth-service
JWT_EXPIRATION=PT1H

# Internal service-to-service audit authentication
INTERNAL_AUDIT_API_KEY=replace-with-a-long-random-internal-api-key
AUDIT_CLIENT_ENABLED=true
AUDIT_CONNECT_TIMEOUT=PT2S
AUDIT_READ_TIMEOUT=PT3S

# Frontend origin accepted by API Gateway
FRONTEND_ORIGIN=http://localhost:5173

# Neon PostgreSQL: Auth service
AUTH_DB_URL=jdbc:postgresql://YOUR_NEON_HOST/cargosphere_dev?sslmode=require&channelBinding=require
AUTH_DB_USERNAME=YOUR_NEON_USERNAME
AUTH_DB_PASSWORD=YOUR_NEON_PASSWORD

# Neon PostgreSQL: Shipment service
SHIPMENT_DB_URL=jdbc:postgresql://YOUR_NEON_HOST/cargosphere_dev?sslmode=require&channelBinding=require
SHIPMENT_DB_USERNAME=YOUR_NEON_USERNAME
SHIPMENT_DB_PASSWORD=YOUR_NEON_PASSWORD

# Neon PostgreSQL: Container service
CONTAINER_DB_URL=jdbc:postgresql://YOUR_NEON_HOST/cargosphere_dev?sslmode=require&channelBinding=require
CONTAINER_DB_USERNAME=YOUR_NEON_USERNAME
CONTAINER_DB_PASSWORD=YOUR_NEON_PASSWORD

# Neon PostgreSQL: Document service
DOCUMENT_DB_URL=jdbc:postgresql://YOUR_NEON_HOST/cargosphere_dev?sslmode=require&channelBinding=require
DOCUMENT_DB_USERNAME=YOUR_NEON_USERNAME
DOCUMENT_DB_PASSWORD=YOUR_NEON_PASSWORD

# Neon PostgreSQL: Payment service
PAYMENT_DB_URL=jdbc:postgresql://YOUR_NEON_HOST/cargosphere_dev?sslmode=require&channelBinding=require
PAYMENT_DB_USERNAME=YOUR_NEON_USERNAME
PAYMENT_DB_PASSWORD=YOUR_NEON_PASSWORD

# Neon PostgreSQL: Audit service
AUDIT_DB_URL=jdbc:postgresql://YOUR_NEON_HOST/cargosphere_dev?sslmode=require&channelBinding=require
AUDIT_DB_USERNAME=YOUR_NEON_USERNAME
AUDIT_DB_PASSWORD=YOUR_NEON_PASSWORD